<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/k1812462/ontologies/2025/10/untitled-ontology-16/"
     xml:base="http://www.semanticweb.org/k1812462/ontologies/2025/10/untitled-ontology-16/"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ore="http://wf4ever.github.io/ro/ore-owl.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/2.3"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="http://purl.org/vocab/frbr/core#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:prov="http://www.w3.org/ns/prov#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:premis="http://www.loc.gov/premis/rdf/v3/"
     xmlns:terms1="http://www.openarchives.org/ore/terms/">
    <owl:Ontology rdf:about="https://github.com/DOWARC/dowarcLITE">
        <owl:versionIRI rdf:resource="https://github.com/DOWARC/dowarcLITE_1.0"/>
        <owl:imports rdf:resource="http://purl.org/pav/2.3"/>
        <owl:imports rdf:resource="http://wf4ever.github.io/ro/ore-owl.owl"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/prov-o-inverses-20130430"/>
        <owl:imports rdf:resource="https://id.loc.gov/ontologies/premis-3-0-0"/>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2024</dc:date>
        <dc:title>dowarcLITE: a (lite) domain ontology for web archiving and web preservation</dc:title>
        <terms:creator>Pallotto Strickland, Manuela</terms:creator>
        <terms:creator>Storrar, Tom</terms:creator>
        <terms:license>Apache License 2.0</terms:license>
        <rdfs:comment rdf:datatype="string">0.1</rdfs:comment>
        <rdfs:comment xml:lang="en">This is a domain ontology created to support the Semantic modelling of WARC files. RDF representations of web archiving data objects can play a critical role in addressing sustainable versioning practices in web archiving and web preservation.</rdfs:comment>
        <rdfs:label>dowarcLITE</rdfs:label>
        <owl:versionInfo xml:lang="en">Current version, draft status; 2026-04-20</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/date -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/date"/>
    


    <!-- http://purl.org/dc/elements/1.1/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/title"/>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <rdf:Description rdf:about="http://purl.org/dc/terms/publisher">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Person"/>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- string -->

    <rdfs:Datatype rdf:about="string"/>
    


    <!-- http://www.semanticweb.org/k1812462/ontologies/2025/10/untitled-ontology-16/string -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/k1812462/ontologies/2025/10/untitled-ontology-16/string"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://id.loc.gov/vocabulary/preservation/relationshipSubType/isr -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/vocabulary/preservation/relationshipSubType/isr">
        <rdfs:subPropertyOf rdf:resource="http://www.loc.gov/premis/rdf/v3/relationship"/>
        <owl:inverseOf rdf:resource="http://id.loc.gov/vocabulary/preservation/relationshipSubType/rep"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcGraph"/>
        <rdfs:comment>A relationship in which an abstract intellectual entity is represented as a file or representation or a software agent is represented by an environment object. Has a reciprocal relationship of represents. (Source: https://id.loc.gov/vocabulary/preservation/relationshipSubType/isr.html)</rdfs:comment>
        <rdfs:label>is Represented By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://id.loc.gov/vocabulary/preservation/relationshipSubType/rep -->

    <owl:ObjectProperty rdf:about="http://id.loc.gov/vocabulary/preservation/relationshipSubType/rep">
        <rdfs:subPropertyOf rdf:resource="http://www.loc.gov/premis/rdf/v3/relationship"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcGraph"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecord"/>
        <rdfs:comment>A relationship in which a file or representation is captured in an abstract intellectual entity description that it represents. It is a statement of what can depict or stand for the Intellectual Entity. Has a reciprocal relationship of isRepresentedBy. (Source: https://id.loc.gov/vocabulary/preservation/relationshipSubType/rep.html)</rdfs:comment>
        <rdfs:label>represents</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/elements/1.1/relation -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/elements/1.1/relation">
        <rdfs:label>dc:relation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/publisher">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/dc/terms/relation -->

    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/relation">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/relation"/>
        <rdfs:comment>A related resource. Recommended practice is to identify the related resource by means of a URI. If this is not possible or feasible, a string conforming to a formal identification system may be provided.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/pav/authoredBy -->

    <rdf:Description rdf:about="http://purl.org/pav/authoredBy">
        <rdfs:domain rdf:resource="http://www.loc.gov/premis/rdf/v3/IntellectualEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Person"/>
    </rdf:Description>
    


    <!-- http://purl.org/pav/createdBy -->

    <rdf:Description rdf:about="http://purl.org/pav/createdBy">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Person"/>
    </rdf:Description>
    


    <!-- http://purl.org/pav/curatedBy -->

    <rdf:Description rdf:about="http://purl.org/pav/curatedBy">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Person"/>
    </rdf:Description>
    


    <!-- http://purl.org/pav/hasVersion -->

    <rdf:Description rdf:about="http://purl.org/pav/hasVersion">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
    </rdf:Description>
    


    <!-- http://purl.org/pav/previousVersion -->

    <rdf:Description rdf:about="http://purl.org/pav/previousVersion">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
    </rdf:Description>
    


    <!-- http://purl.org/pav/providedBy -->

    <rdf:Description rdf:about="http://purl.org/pav/providedBy">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Person"/>
    </rdf:Description>
    


    <!-- http://www.loc.gov/premis/rdf/v3/identifier -->

    <rdf:Description rdf:about="http://www.loc.gov/premis/rdf/v3/identifier">
        <rdfs:domain rdf:resource="http://purl.org/dc/dcmitype/Collection"/>
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    </rdf:Description>
    


    <!-- http://www.loc.gov/premis/rdf/v3/signature -->

    <rdf:Description rdf:about="http://www.loc.gov/premis/rdf/v3/signature">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
    </rdf:Description>
    


    <!-- http://www.loc.gov/premis/rdf/v3/storedAt -->

    <rdf:Description rdf:about="http://www.loc.gov/premis/rdf/v3/storedAt">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#ConfigFile"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCdxFile"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcGraph"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
        <rdfs:range rdf:resource="http://www.loc.gov/premis/rdf/v3/StorageMedium"/>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/aggregates -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/aggregates">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/hasPart"/>
        <owl:inverseOf rdf:resource="http://www.openarchives.org/ore/terms/isAggregatedBy"/>
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecord"/>
        <rdfs:range rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecord"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordContentBlock"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordHeader"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
        <rdfs:comment>Aggregations, by definition, aggregate resources. The ore:aggregates relationship expresses that the object resource is a member of the set of Aggregated Resources of the subject (the Aggregation). This relationship between the Aggregation and its Aggregated Resources is thus more specific than a simple part/whole relationship, as expressed by dcterms:hasPart for example.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Aggregates</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/describes -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/describes">
        <owl:inverseOf rdf:resource="http://www.openarchives.org/ore/terms/isDescribedBy"/>
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/ResourceMap"/>
        <rdfs:range rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:comment>This relationship asserts that the subject (a Resource Map) describes the object (an Aggregation).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Describes</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/isAggregatedBy -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/isAggregatedBy">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/isPartOf"/>
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecord"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordContentBlock"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordHeader"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
        <rdfs:range rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecord"/>
        <rdfs:comment>The inverse relationship of ore:aggregates, ore:isAggregatedBy asserts that an Aggregated Resource is aggregated by an Aggregation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Is Aggregated By</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/isDescribedBy -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/isDescribedBy">
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:range rdf:resource="http://www.openarchives.org/ore/terms/ResourceMap"/>
        <rdfs:comment>The inverse relationship of ore:describes, in this case the object of the relationship is the Resource Map and the subject is the Aggregation which it describes.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Is Described By</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/lineage -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/lineage">
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/Proxy"/>
        <rdfs:range rdf:resource="http://www.openarchives.org/ore/terms/Proxy"/>
        <rdfs:comment>ore:lineage is a relationship between two Proxy objects, both of which MUST have the same Resource for which they are proxies. The meaning is that the Resource for which the subject of the relationship is a Proxy was discovered in the Aggregation in which the object Proxy&apos;s resource is aggregated.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Lineage</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/proxyFor -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/proxyFor">
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/Proxy"/>
        <rdfs:range rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:comment>Proxy objects are used to represent a Resource as it is aggregated in a particular Aggregation. The ore:proxyFor relationship is used to link the proxy to the Aggregated Resource it is a proxy for. The subject of the relationship is a Proxy object, and the object of the relationship is the Aggregated Resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Proxy For</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/proxyIn -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/proxyIn">
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/Proxy"/>
        <rdfs:range rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:comment>Proxy objects must link to the Aggregation in which the resource being proxied is aggregated. The ore:proxyIn relationship is used for this purpose. The subject of the relationship is a Proxy object, and the object of the relationship is the Aggregation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Proxy In</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.openarchives.org/ore/terms/similarTo -->

    <rdf:Description rdf:about="http://www.openarchives.org/ore/terms/similarTo">
        <rdfs:domain rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:comment>The subject of this relationship MUST be an Aggregation.  This Aggregation should be considered an expression within the ORE context of the object of the relationship, as it is broadly equivalent to the resource. For example, the Aggregation may consist of the resources which, together, make up a journal article which has a DOI assigned to it. The Aggregation is not the article to which the DOI was assigned, but is a representation of it in some manner.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Similar To</rdfs:label>
    </rdf:Description>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://www.w3.org/ns/prov#generated -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#generated">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Crawling"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Extracting"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Indexing"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Publishing"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#QA"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Replaying"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCdxFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecord"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordContentBlock"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordHeader"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#locationOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#locationOf"/>
    


    <!-- http://www.w3.org/ns/prov#used -->

    <rdf:Description rdf:about="http://www.w3.org/ns/prov#used">
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Crawling"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Extracting"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Indexing"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Publishing"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#QA"/>
        <rdfs:domain rdf:resource="https://github.com/DOWARC/dowarcLITE#Replaying"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#ConfigFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCdxFile"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcCollection"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcFile"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/prov#wasAssociateFor -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociateFor">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Organization"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Person"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#SoftwareAgent"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#Crawling"/>
        <rdfs:range rdf:resource="https://github.com/DOWARC/dowarcLITE#Extracting"/>
