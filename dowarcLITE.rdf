    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/MediaTypeOrExtent -->

    <owl:Class rdf:about="http://purl.org/dc/terms/MediaTypeOrExtent"/>
    


    <!-- http://www.openarchives.org/ore/terms/AggregatedResource -->

    <owl:Class rdf:about="http://www.openarchives.org/ore/terms/AggregatedResource">
        <rdfs:comment>A resource which is included in an Aggregation. Note that asserting that a resource is a member of the class of Aggregated Resources does not imply anything other than that it is aggregated by at least one Aggregation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Aggregated Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://www.openarchives.org/ore/terms/Aggregation -->

    <owl:Class rdf:about="http://www.openarchives.org/ore/terms/Aggregation">
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/dcmitype/Collection"/>
        <rdfs:comment>A set of related resources (Aggregated Resources), grouped together such that the set can be treated as a single resource. This is the entity described within the ORE interoperability framework by a Resource Map.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Aggregation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.openarchives.org/ore/terms/Proxy -->

    <owl:Class rdf:about="http://www.openarchives.org/ore/terms/Proxy">
        <rdfs:comment>A Proxy represents an Aggregated Resource as it exists in a specific Aggregation. All assertions made about an entity are globally true, not only within the context of the Aggregation. As such, in order to make assertions which are only true of a resource as it exists in an Aggregation, a Proxy object is required. For example, one might want to cite an article as it appears in a specific journal, or assign aggregation-specific metadata to a Resource.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Proxy</rdfs:label>
    </owl:Class>
    


    <!-- http://www.openarchives.org/ore/terms/ResourceMap -->

    <owl:Class rdf:about="http://www.openarchives.org/ore/terms/ResourceMap">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/03/trix/rdfg-1/Graph"/>
        <rdfs:comment>A description of an Aggregation according to the OAI-ORE data model. Resource Maps are serialised to a machine readable format according to the implementation guidelines.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openarchives.org/ore/terms/"/>
        <rdfs:label>Resource Map</rdfs:label>
    </owl:Class>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#Resource -->

    <owl:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    


    <!-- https://github.com/DOWARC/dowarcLITE#ArchivedWebResource -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#ArchivedWebResource">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/Representation"/>
        <rdfs:comment>A resource made available online. It can be a website or a webpage or a digital object embedded in a webpage or linked to by a webpage. It is always intended as the digital &apos;representation of&apos; an untangible/intellectual entity. It is also &apos;represented by&apos; its archival counterpart, which is rendered (replayed) using WARC files.</rdfs:comment>
        <rdfs:label>ArchivedWebResource</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#ConfigFile -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#ConfigFile">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/File"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#Crawling -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#Crawling">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>The act of creating an archive through the process of capturing data into a WARC file.</rdfs:comment>
        <rdfs:label>Crawling</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#Extracting -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#Extracting">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>The act of extracting data from a WARC file and/or a CDX file.</rdfs:comment>
        <rdfs:label>Extracting</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#Indexing -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#Indexing">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>The creation of an index (CDX or CDXJ) file of a WARC file. Source: https://pywb.readthedocs.io/en/master/manual/indexing.html</rdfs:comment>
        <rdfs:label>Indexing</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#Publishing -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#Publishing">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>The act of making a WARC file, or resources within a WARC file, availavable for use.</rdfs:comment>
        <rdfs:label>Publishing</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#QA -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#QA">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>The act of checking the quality of a web archive using a combination of data-driven and manual checks. This process includes the act of patching, during which time missing content is added to the archive to improve its completeness or quality.</rdfs:comment>
        <rdfs:label>QA</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#Replaying -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#Replaying">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment>Retrieval and rendering of the data stored in a WARC file over HTTP. This may be through a Wayback-style system via a browser, or programatically replayed in some other way.</rdfs:comment>
        <rdfs:label>Replaying</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcAIP -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcAIP">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/File"/>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcCdxFile -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcCdxFile">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/File"/>
        <rdfs:comment>An index (normally a CDX or CDXJ) file of a WARC file. Source: https://pywb.readthedocs.io/en/master/manual/indexing.html</rdfs:comment>
        <rdfs:label>WarcCdxFile</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcCollection -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcCollection">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/Representation"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:comment>A collection of WARC records aggregating all the resources harvested by web crawling activities, which, taken together, provide an exhaustive representation of a live web resource (e.g., a web site, a web page). Subclass of ore:Aggregation.</rdfs:comment>
        <rdfs:label>WarcCollection</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcFile -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcFile">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/File"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:comment>A container file that aggregates a sequence of structured information chunks (WARC records), storing data and metadata. WARC files are the output of web crawling automated activities. A WARC file can contain one or more digital object with multiple media types (i.e., MIME). Subclass of ore:Aggregation.</rdfs:comment>
        <rdfs:label>WarcFile</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcFileSignature -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcFileSignature">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/Fixity"/>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcGraph -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcGraph">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/Representation"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/ResourceMap"/>
        <rdfs:comment>An RDF graph that represents and describes the relationships between the WARC file and the resources it aggregates, as well as the relationships between the aggregated resources. A WARC graph can be used to represent the relationship between the resources stored in a WARCcollection and the web page(s) or web site(s) from which the resources were harvested. In this respect, a WARCgraph can provide a representation of the live web object being archived. A WARCgraph can be a subgraph of another WARCgraph.</rdfs:comment>
        <rdfs:label>WarcGraph</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcRecord -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcRecord">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/Bitstream"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
        <rdfs:comment>A WARC record is a component of a WARC file. A WARC record includes data retrieved from a source in the live Wide World Web, together with synthetic (meta)data providing information about the retrieved content. A WARC record has a header and a content block carrying the payload for the live web data object that was harvested over the HTTP. A WARC record is both an aggregated resource (component of a WARC file) and an aggregation (it includes sub-elements of its own).</rdfs:comment>
        <rdfs:label>WarcRecord</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcRecordContentBlock -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcRecordContentBlock">
        <rdfs:subClassOf rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:comment>Part (zero or more octets) of a WARC record that follows the header and that forms the main body of a WARC record. (Source: https://iipc.github.io/warc-specifications/specifications/warc-format/warc-1.0/#terms-and-definitions)</rdfs:comment>
        <rdfs:label>WarcRecordContentBlock</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcRecordElement -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcRecordElement">
        <rdfs:subClassOf rdf:resource="http://www.loc.gov/premis/rdf/v3/Bitstream"/>
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/AggregatedResource"/>
        <rdfs:comment>A bitstream object aggregated in a WARC record.</rdfs:comment>
        <rdfs:label>WarcRecordElement</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcRecordHeader -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcRecordHeader">
        <rdfs:subClassOf rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:comment>Beginning of a WARC record, consisting of one first line declaring the record to be in the WARC format with a given version number, followed by lines of named fields up to a blank line. (Source: https://iipc.github.io/warc-specifications/specifications/warc-format/warc-1.0/#terms-and-definitions)</rdfs:comment>
        <rdfs:label>WarcRecordHeader</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcRecordPayload -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcRecordPayload">
        <rdfs:subClassOf rdf:resource="https://github.com/DOWARC/dowarcLITE#WarcRecordElement"/>
        <rdfs:comment>Data object referred to, or contained by a WARC record as a meaningful subset of the content block. (Source: https://iipc.github.io/warc-specifications/specifications/warc-format/warc-1.0/#terms-and-definitions)</rdfs:comment>
        <rdfs:label>WarcRecordPayload</rdfs:label>
    </owl:Class>
    


    <!-- https://github.com/DOWARC/dowarcLITE#WarcSIP -->

    <owl:Class rdf:about="https://github.com/DOWARC/dowarcLITE#WarcSIP">
        <rdfs:subClassOf rdf:resource="http://www.openarchives.org/ore/terms/Aggregation"/>
    </owl:Class>
    


